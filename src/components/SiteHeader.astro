@media (min-width: 640px) {
  .site-header-inner { min-height: 5rem; }
  .site-header-cta { display: inline-flex; }
}

@media (min-width: 1024px) {
  .site-header-inner { padding-left: 3rem; padding-right: 3rem; }
  .site-menu-toggle { display: none; }
  .site-nav { display: flex; }
}

@media (prefers-reduced-motion: reduce) {
  .site-nav-link,
  .site-nav-link::after { transition: none; }
}
:global(html) { scroll-padding-top: 4rem; }

@media (min-width: 640px) {
  .site-header-inner { min-height: 5rem; }
  .site-header-cta { display: inline-flex; }
  :global(html) { scroll-padding-top: 5rem; }
}
</style>
