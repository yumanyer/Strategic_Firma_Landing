<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-brand-group">
      <a class="site-brand" data-path="servicios" href="#hero">
        <span class="site-brand-name">FIRMA<span class="site-brand-sub">Strategic</span></span>
      </a>
    </div>
    <button aria-controls="site-nav" aria-expanded="false" aria-label="Abrir menú de navegación" class="site-menu-toggle" type="button">
      <span aria-hidden="true" class="material-symbols-outlined">menu</span>
    </button>
    <nav class="site-nav" id="site-nav">
      <a class="site-nav-link" data-path="quienes-somos" href="#quienes-somos">Quiénes Somos</a>
      <a class="site-nav-link" data-path="servicios" href="#servicios">Servicios</a>
      <a class="site-nav-link" data-path="acompanamiento" href="#acompanamiento">Acompañamiento</a>
      <a class="site-nav-link" data-path="metodologia" href="#metodologia">Metodología</a>
      <a class="site-nav-link" data-path="contacto" href="#contacto">Contacto</a>
      <a class="site-nav-cta" data-path="contacto" href="#contacto">Solicitar asesoramiento</a>
    </nav>
    <div class="site-header-actions">
      <a class="site-header-cta" data-path="contacto" href="#contacto">Solicitar asesoramiento</a>
    </div>
  </div>
</header>

<script>
  type NavItem = {
    link: HTMLAnchorElement;
    section: HTMLElement;
    visible: boolean;
  };

  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".site-menu-toggle");
  const nav = document.getElementById("site-nav");

  if (header && toggle && nav) {
    const icon = toggle.querySelector<HTMLElement>(".material-symbols-outlined");

    const setMenuOpen = (open: boolean) => {
      header.dataset.menuOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
      if (icon) icon.textContent = open ? "close" : "menu";
    };

    toggle.addEventListener("click", () => setMenuOpen(header.dataset.menuOpen !== "true"));

    nav.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("a")) setMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.dataset.menuOpen === "true") {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node | null;
      if (header.dataset.menuOpen === "true" && !header.contains(target)) setMenuOpen(false);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && header.dataset.menuOpen === "true") setMenuOpen(false);
    }, { passive: true });
  }

  const navItems: NavItem[] = [];
  document
    .querySelectorAll<HTMLAnchorElement>(".site-nav-link[href^='#']")
    .forEach((link) => {
      const id = link.getAttribute("href")?.slice(1);
      const section = id ? document.getElementById(id) : null;
      if (section) navItems.push({ link, section, visible: false });
    });

  if (navItems.length) {
    let observer: IntersectionObserver | null = null;
    let activeItem: NavItem | null = null;
    let lockItem: NavItem | null = null; // NEW: enlace fijado mientras dura el desplazamiento animado
    let headerHeight = 0;
    let band = 0;
    let resizeFrame = 0;

    const setActive = (item: NavItem) => {
      if (activeItem === item) return;
      if (activeItem) {
        activeItem.link.classList.remove("is-current");
        activeItem.link.removeAttribute("aria-current");
      }
      activeItem = item;
      item.link.classList.add("is-current");
      item.link.setAttribute("aria-current", "location");
    };

    const chooseActive = () => {
      if (lockItem) return; // CHANGED: el scroll spy no compite con el desplazamiento animado

      let topmost: NavItem | null = null;
      let topmostPosition = -Infinity;

      for (const item of navItems) {
        if (!item.visible) continue;
        const top = item.section.getBoundingClientRect().top;
        if (top > topmostPosition) {
          topmostPosition = top;
          topmost = item;
        }
      }

      if (topmost) {
        setActive(topmost);
        return;
      }

      const firstTop = navItems[0].section.getBoundingClientRect().top + window.scrollY;
      if (window.scrollY + headerHeight + band < firstTop) setActive(navItems[0]);
    };

    const observeSections = () => {
      if (observer) observer.disconnect();

      headerHeight = header ? header.getBoundingClientRect().height : 0;
      band = Math.max(48, Math.round(window.innerHeight * 0.12));
      const bottomMargin = -Math.max(0, window.innerHeight - headerHeight - band);

      for (const item of navItems) item.visible = false;

      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const item = navItems.find((candidate) => candidate.section === entry.target);
          if (item) item.visible = entry.isIntersecting;
        }
        chooseActive();
      }, {
        root: null,
        rootMargin: `-${Math.round(headerHeight)}px 0px ${Math.round(bottomMargin)}px 0px`,
        threshold: 0,
      });

      for (const item of navItems) observer.observe(item.section);
    };

    observeSections();

    window.addEventListener("resize", () => {
      if (resizeFrame) return;
      resizeFrame = window.requestAnimationFrame(() => {
        resizeFrame = 0;
        observeSections();
      });
    }, { passive: true });

    // ---------- NEW: desplazamiento suave hacia las secciones ----------
    const SCROLL_MIN_MS = 600;
    const SCROLL_MAX_MS = 900;
    const SCROLL_KEYS = new Set(["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "]);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let scrollFrame = 0;
    let holdY = 0;

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    const maxScroll = () =>
      Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

    // Posición de scroll en la que la sección queda justo debajo del header fijo (sin acotar)
    const rawTargetY = (section: HTMLElement) => {
      const currentHeader = header ? header.getBoundingClientRect().height : 0;
      return Math.round(section.getBoundingClientRect().top + window.scrollY - currentHeader + 1);
    };
    const targetY = (section: HTMLElement) => Math.min(Math.max(0, rawTargetY(section)), maxScroll());

    const jumpTo = (y: number) => window.scrollTo({ top: y, behavior: "instant" });

    const interrupt = () => {
      if (!scrollFrame) return;
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      lockItem = null;
      chooseActive(); // prevalece la posición real del usuario
    };

    const scrollToSection = (item: NavItem | null, section: HTMLElement) => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;

      lockItem = item;
      if (item) setActive(item);

      const finish = () => {
        scrollFrame = 0;
        // Sección final de la página que no llega a subir hasta el header: se mantiene
        // activa hasta que el usuario vuelva a mover el scroll.
        if (item && rawTargetY(section) > maxScroll() + 2) {
          holdY = window.scrollY;
          return;
        }
        lockItem = null;
        chooseActive();
      };

      const startY = window.scrollY;
      const distance = Math.abs(targetY(section) - startY);

      if (reducedMotion.matches || distance < 2) {
        jumpTo(targetY(section));
        finish();
        return;
      }

      const duration = Math.min(SCROLL_MAX_MS, Math.max(SCROLL_MIN_MS, distance * 0.5));
      const startTime = performance.now();
      let lastY = startY;

      const step = (now: number) => {
        // Si la posición no es la que dejamos, el usuario movió el scroll (barra, teclado, etc.)
        if (Math.abs(window.scrollY - lastY) > 3) {
          interrupt();
          return;
        }
        const t = Math.min(1, Math.max(0, (now - startTime) / duration));
        // El destino se recalcula en cada frame: absorbe cambios de layout durante la animación
        jumpTo(Math.round(startY + (targetY(section) - startY) * easeInOutCubic(t)));
        lastY = window.scrollY;
        if (t < 1) scrollFrame = requestAnimationFrame(step);
        else finish();
      };
      scrollFrame = requestAnimationFrame(step);
    };

    header?.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const target = event.target;
      if (!(target instanceof Element)) return;
      const anchor = target.closest<HTMLAnchorElement>("a[href^='#']");
      if (!anchor) return;

      const hash = anchor.getAttribute("href") ?? "";
      const section = hash.length > 1 ? document.getElementById(hash.slice(1)) : null;
      if (!section) return;

      event.preventDefault();
      const item = navItems.find((candidate) => candidate.section === section) ?? null;
      if (location.hash !== hash) history.pushState(null, "", hash);

      // El listener de <nav> ya cerró el menú mobile (burbujea antes que éste); el panel es
      // absolute, así que no cambia el layout. Arrancamos en el siguiente frame.
      requestAnimationFrame(() => scrollToSection(item, section));
    });

    // Interrupciones manuales: rueda, toque y teclas de scroll cancelan la animación
    window.addEventListener("wheel", interrupt, { passive: true });
    window.addEventListener("touchstart", interrupt, { passive: true });
    window.addEventListener("keydown", (event) => {
      if (SCROLL_KEYS.has(event.key)) interrupt();
    });

    // Libera el enlace "retenido" cuando el usuario se mueve de verdad
    window.addEventListener("scroll", () => {
      if (lockItem && !scrollFrame && Math.abs(window.scrollY - holdY) > 4) {
        lockItem = null;
        chooseActive();
      }
    }, { passive: true });

    window.addEventListener("pagehide", () => {
      cancelAnimationFrame(scrollFrame);
      if (observer) observer.disconnect();
    }, { once: true });
  }
</script>

<style>
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 50;
  background-color: color-mix(in srgb, var(--color-surface-container-lowest) 90%, transparent);
  backdrop-filter: blur(12px);
  box-shadow: 0 1px 8px rgba(15, 20, 28, 0.06);
}

.site-header-inner {
  min-height: 4rem;
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: clamp(1rem, 4vw, 1.5rem);
  padding-right: clamp(1rem, 4vw, 1.5rem);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.site-header-brand-group,
.site-header-actions {
  display: flex;
  align-items: center;
}

.site-header-brand-group { gap: var(--space-space-lg); }
.site-header-actions { gap: var(--space-space-md); }

.site-brand {
  display: flex;
  align-items: center;
  min-height: 44px;
  gap: var(--space-space-xs);
}


.site-brand-name {
  font-family: var(--font-display);
  font-size: clamp(20px, 5vw, 24px);
  line-height: 32px;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--color-primary);
}

.site-brand-sub {
  font-family: var(--font-sans);
  font-size: clamp(11px, 3vw, 15px);
  line-height: 24px;
  font-weight: 400;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-on-surface-variant);
  margin-left: clamp(0.25rem, 1.5vw, 0.5rem);
  padding-left: clamp(0.25rem, 1.5vw, 0.5rem);
  border-left: 1px solid var(--color-outline-variant);
}

.site-menu-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 44px;
  min-height: 44px;
  margin-left: auto;
  background-color: var(--color-surface-container);
  color: var(--color-primary);
}

.site-menu-toggle .material-symbols-outlined { font-size: 24px; }

.site-nav {
  display: none;
  align-items: center;
  gap: 2rem;
}

.site-header[data-menu-open="true"] .site-nav {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  max-height: calc(100vh - 4rem);
  overflow-y: auto;
  padding: 0.5rem clamp(1rem, 4vw, 1.5rem) 1rem;
  background-color: var(--color-surface-container-lowest);
  box-shadow: var(--shadow-md);
}

.site-nav-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-family: var(--font-sans);
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-on-surface-variant);
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

.site-nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background-color: var(--color-primary);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.site-nav-cta {
  display: none;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 0.5rem;
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  font-family: var(--font-sans);
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.site-header .site-menu-toggle:focus-visible,
.site-header a:focus-visible {
  outline: 2px solid var(--color-secondary);
  outline-offset: 2px;
}

.site-nav-link:hover,
.site-nav-link:focus-visible,
.site-nav-link.is-current {
  color: var(--color-primary);
}

.site-nav-link:hover::after,
.site-nav-link:focus-visible::after,
