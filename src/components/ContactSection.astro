<section
          class="fs-w-full fs-bg-surface-container-low fs-py-space-xl fs-lg--py-24"
          id="contacto"
        >
          <div class="fs-max-w-7xl fs-mx-auto fs-px-6 fs-lg--px-12">
            <!-- Section Tag -->
            <div class="fs-max-w-3xl fs-mb-space-xl">
              <span
                class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-widest fs-text-secondary fs-block fs-font-semibold"
                >05 // CONVERSIÓN &amp; ASESORAMIENTO</span
              >
              <h2
                class="fs-font-headline-lg fs-text-headline-lg fs-lg--text-display-lg fs-text-primary fs-font-semibold fs-mt-space-xs"
              >
                Comencemos a estructurar tu operación.
              </h2>
              <p
                class="fs-font-body-md fs-text-body-md fs-text-on-surface-variant fs-mt-space-xs fs-leading-relaxed"
              >
                Ponte en contacto directo con uno de nuestros directores
                estratégicos. Toda consulta se encuentra amparada bajo estricto
                secreto profesional.
              </p>
            </div>
            <!-- Dual Split Panel Grid -->
            <div class="fs-grid fs-grid-cols-1 fs-lg--grid-cols-12 fs-gap-gutter-desktop">
              <!-- Left Side: Channels & Direct Line (5 cols) -->
              <div
                class="fs-lg--col-span-5 fs-bg-primary fs-text-on-primary fs-p-space-lg fs-lg--p-space-xl fs-flex fs-flex-col fs-justify-between fs-shadow-xl"
              >
                <div class="fs-space-y-space-md">
                  <div>
                    <span
                      class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-widest fs-text-secondary-fixed fs-block"
                      >Canal Directo de Alta Prioridad</span
                    >
                    <h3
                      class="fs-font-headline-md fs-text-headline-md fs-font-semibold fs-mt-1"
                    >
                      Atención personalizada sin intermediarios.
                    </h3>
                  </div>
                  <p
                    class="fs-font-body-sm fs-text-body-sm fs-text-surface-container-highest fs-leading-relaxed"
                  >
                    Si tu operación requiere resolución inmediata o necesitas
                    validar viabilidad en menos de 24 horas, comunícate
                    directamente con nuestro equipo de guardia estratégica.
                  </p>
                  <!-- Direct Contact List -->
                  <div class="fs-space-y-space-md fs-pt-space-xs">
                    <a
                      class="fs-flex fs-items-center fs-gap-space-sm fs-p-space-md fs-bg-inverse-surface fs-hover--bg-surface-tint fs-transition-all fs-group"
                      href="https://wa.me/5491100000000?text=Hola,%20quiero%20consultar%20sobre%20los%20servicios%20de%20Firma%20Strategic..."
                      id="dynamic-wa-link"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <span
                        class="fs-material-symbols-outlined fs-text-secondary-fixed fs-text--24px"
                        >chat</span
                      >
                      <div>
                        <span
                          class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-surface-container-highest fs-block"
                          >WhatsApp Institucional</span
                        >
                        <span
                          class="fs-font-headline-sm fs-text-headline-sm fs-text-on-primary fs-font-semibold"
                          >+54 9 11 0000-0000</span
                        >
                      </div>
                      <span
                        class="fs-material-symbols-outlined fs-ml-auto fs-text-on-primary fs-group-hover--translate-x-1 fs-transition-transform"
                        >arrow_forward</span
                      >
                    </a>
                    <div
                      class="fs-flex fs-items-center fs-gap-space-sm fs-p-space-md fs-bg-inverse-surface"
                    >
                      <span
                        class="fs-material-symbols-outlined fs-text-secondary-fixed fs-text--24px"
                        >mail</span
                      >
                      <div>
                        <span
                          class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-surface-container-highest fs-block"
                          >Correo Confidencial</span
                        >
                        <span
                          class="fs-font-headline-sm fs-text-headline-sm fs-text-on-primary fs-font-semibold"
                          >contacto@firmastrategic.com</span
                        >
                      </div>
                    </div>
                  </div>
                  <!-- Guarantee Badges -->
                  <div class="fs-space-y-space-xs fs-pt-space-md">
                    <div
                      class="fs-flex fs-items-center fs-gap-2 fs-text-surface-container-highest"
                    >
                      <span
                        class="fs-material-symbols-outlined fs-text--18px fs-text-secondary-fixed"
                        >lock</span
                      >
                      <span class="fs-font-body-sm fs-text-body-sm"
                        >Acuerdo de Confidencialidad y Secreto Profesional
                        (NDA)</span
                      >
                    </div>
                    <div
                      class="fs-flex fs-items-center fs-gap-2 fs-text-surface-container-highest"
                    >
                      <span
                        class="fs-material-symbols-outlined fs-text--18px fs-text-secondary-fixed"
                        >timer</span
                      >
                      <span class="fs-font-body-sm fs-text-body-sm"
                        >Respuesta y diagnóstico inicial en menos de 24 horas
                        hábiles</span
                      >
                    </div>
                  </div>
                </div>
                <div
                  class="fs-pt-space-lg fs-text-surface-container-highest fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider"
                >
                  Sede Operativa: Buenos Aires · Miami · Londres
                </div>
              </div>
              <!-- Right Side: Structured Contact Form (7 cols) -->
              <div
                class="fs-lg--col-span-7 fs-bg-surface-container-lowest fs-p-space-lg fs-lg--p-space-xl fs-shadow-xl"
              >
                <form
                  class="fs-space-y-space-md"
                  id="strategic-contact-form"
                  onsubmit="handleFormSubmit(event)"
                >
                  <div class="fs-grid fs-grid-cols-1 fs-sm--grid-cols-2 fs-gap-space-md">
                    <div>
                      <label
                        class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                        for="form-name"
                        >Nombre completo *</label
                      >
                      <input
                        class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm"
                        id="form-name"
                        placeholder="Ej. Carlos Mendoza"
                        required=""
                        type="text"
                      />
                    </div>
                    <div>
                      <label
                        class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                        for="form-email"
                        >Correo electrónico corporativo *</label
                      >
                      <input
                        class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm"
                        id="form-email"
                        placeholder="carlos@empresa.com"
                        required=""
                        type="email"
                      />
                    </div>
                  </div>
                  <div class="fs-grid fs-grid-cols-1 fs-sm--grid-cols-2 fs-gap-space-md">
                    <div>
                      <label
                        class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                        for="form-phone"
                        >Teléfono / WhatsApp *</label
                      >
                      <input
                        class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm"
                        id="form-phone"
                        placeholder="+54 9 11 ..."
                        required=""
                        type="tel"
                      />
                    </div>
                    <div>
                      <label
                        class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                        for="form-profile"
                        >Perfil del consultante *</label
                      >
                      <select
                        class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm"
                        id="form-profile"
                        onchange="updateWhatsAppIntent()"
                      >
                        <option value="Emprendedor / Profesional">
                          Emprendedor / Profesional Independiente
                        </option>
                        <option value="Comerciante / Dueño de negocio">
                          Comerciante / Dueño de Negocio
                        </option>
                        <option value="Empresario / Empresa">
                          Empresario / Empresa Consolidada
                        </option>
                        <option value="Otro">Otro perfil específico</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label
                      class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                      for="form-area"
                      >Área principal de interés *</label
                    >
                    <select
                      class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm"
                      id="form-area"
                      onchange="updateWhatsAppIntent()"
                    >
                      <option value="Finanzas">
                        Soluciones Financieras (Divisas, USDT, Tesorería)
                      </option>
                      <option value="Comercio Exterior">
                        Comercio Exterior (Importación, Logística, Aduana)
                      </option>
                      <option value="Internacionalización">
                        Internacionalización (LLC, Apertura de Cuentas, Tax)
                      </option>
                      <option value="Mixto">
                        Integración Mixta (Finanzas + Comercio Exterior +
                        Societario)
                      </option>
                    </select>
                  </div>
                  <div>
                    <label
                      class="fs-font-label-sm fs-text-label-sm fs-uppercase fs-tracking-wider fs-text-on-surface-variant fs-block fs-mb-1"
                      for="form-detail"
                      >Breve detalle de tu necesidad u operación *</label
                    >
                    <textarea
                      class="fs-w-full fs-p-3 fs-bg-surface-container-lowest fs-text-on-surface fs-font-body-sm fs-text-body-sm fs-focus--outline-none fs-focus--ring-1 fs-focus--ring-primary fs-shadow-sm fs-resize-none"
                      id="form-detail"
                      placeholder="Describe los montos aproximados, países de origen/destino o tipo de sociedad requerida..."
                      required=""
                      rows="4"
                    ></textarea>
                  </div>
                  <div class="fs-flex fs-items-center fs-gap-2 fs-pt-space-xs">
                    <input
                      checked=""
                      class="fs-w-4 fs-h-4 fs-text-primary fs-rounded-none fs-focus--ring-0"
                      id="form-nda"
                      required=""
                      type="checkbox"
                    />
                    <label
                      class="fs-font-body-sm fs-text-body-sm fs-text-on-surface-variant"
                      for="form-nda"
                    >
                      Solicito evaluación amparada en acuerdo de estricta
                      reserva y secreto fiduciario.
                    </label>
                  </div>
                  <div class="fs-pt-space-sm">
                    <button
                      class="fs-w-full fs-py-4 fs-bg-primary fs-text-on-primary fs-font-label-md fs-text-label-md fs-uppercase fs-tracking-wider fs-hover--bg-inverse-surface fs-transition-all fs-flex fs-items-center fs-justify-center fs-gap-2 fs-shadow-md"
                      id="form-submit-btn"
                      type="submit"
                    >
                      <span>Solicitar evaluación estratégica</span>
                      <span class="fs-material-symbols-outlined fs-text--18px"
                        >send</span
                      >
                    </button>
                  </div>
                  <!-- Instant Feedback Notification Block -->
                  <div
                    class="fs-hidden fs-p-space-md fs-bg-secondary-fixed fs-text-on-secondary-fixed fs-space-y-1"
                    id="form-success-banner"
                  >
                    <div
                      class="fs-flex fs-items-center fs-gap-2 fs-font-headline-sm fs-text-headline-sm"
                    >
                      <span class="fs-material-symbols-outlined fs-text-secondary"
                        >check_circle</span
                      >
                      <span>Evaluación Registrada con Éxito</span>
                    </div>
                    <p class="fs-font-body-sm fs-text-body-sm">
                      Hemos asignado tu requerimiento al equipo directivo. Te
                      contactaremos en un plazo máximo de 24 horas hábiles vía
                      WhatsApp o correo corporativo.
                    </p>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>
